rules_version = '2';
// Tutti gli accessi passano dal server (Firebase Admin SDK, che ignora queste regole).
// Nessun client (browser) deve poter leggere o scrivere direttamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
